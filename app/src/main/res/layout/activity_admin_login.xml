<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PharmaFind"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#287B5B"
            android:gravity="center"
            android:layout_marginTop="60dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connectez-vous à votre espace"
            android:textSize="18sp"
            android:textColor="#173F35"
            android:gravity="center"
            android:layout_marginTop="15dp"/>

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Adresse email"
            android:inputType="textEmailAddress"
            android:layout_marginTop="40dp"/>

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Mot de passe"
            android:inputType="textPassword"/>

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Se connecter"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#287B5B"
            android:layout_marginTop="25dp"/>

        <TextView
            android:id="@+id/tvSignup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vous n'avez pas un compte ? Créer un compte"
            android:textColor="#287B5B"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="18dp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>
</ScrollView>
