<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modifier la pharmacie"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#173F35"/>

        <TextView
            android:text="Nom de la pharmacie"
            android:textColor="#173F35"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"/>

        <EditText
            android:id="@+id/edtPharmacyName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Nom de la pharmacie"
            android:singleLine="true"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"/>

        <TextView
            android:text="Adresse"
            android:textColor="#173F35"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"/>

        <EditText
            android:id="@+id/edtPharmacyAddress"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Adresse de la pharmacie"
            android:singleLine="true"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"/>

        <Button
            android:id="@+id/btnSavePharmacy"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Enregistrer les modifications"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#287B5B"
            android:layout_marginTop="30dp"/>

    </LinearLayout>
</ScrollView>
