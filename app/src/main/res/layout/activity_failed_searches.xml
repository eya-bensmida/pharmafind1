<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F8F6">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recherches infructueuses"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#173F35"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Médicaments recherchés mais indisponibles"
        android:textColor="#888888"
        android:textSize="14sp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:id="@+id/txtFailedCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 recherches enregistrées"
        android:textColor="#287B5B"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <ListView
        android:id="@+id/listFailedSearches"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="#DDE8E1"
        android:dividerHeight="10dp"/>

</LinearLayout>
