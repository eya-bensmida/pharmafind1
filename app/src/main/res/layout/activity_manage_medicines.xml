<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8F6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp"
        android:paddingTop="32dp">

        <!-- En-tête PharmaFind -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="PharmaFind"
            android:textColor="#218C58"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Titre principal -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:gravity="center"
            android:text="Gestion des médicaments"
            android:textColor="#1B5E20"
            android:textSize="25sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Consultez, modifiez et gérez les médicaments de votre pharmacie."
            android:textColor="#718078"
            android:textSize="14sp" />

        <!-- Nombre de médicaments -->
        <TextView
            android:id="@+id/txtMedicineCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="12dp"
            android:text="Nombre de médicaments : 0"
            android:textColor="#218C58"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Message si aucun médicament -->
        <TextView
            android:id="@+id/txtEmptyMedicines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:gravity="center"
            android:padding="20dp"
            android:text="Aucun médicament disponible dans votre pharmacie."
            android:textColor="#718078"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- Liste dynamique des médicaments -->
        <LinearLayout
            android:id="@+id/layoutMedicineList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>
