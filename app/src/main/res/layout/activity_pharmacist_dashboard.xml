<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8F6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- En-tête PharmaFind -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp"
            android:background="#E1F2E8">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PharmaFind"
                android:textColor="#218C58"
                android:textSize="27sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="TABLEAU DE BORD"
                android:textColor="#14532D"
                android:textSize="25sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Bienvenue dans votre espace pharmacien"
                android:textColor="#52665A"
                android:textSize="14sp"
                android:gravity="center" />

        </LinearLayout>

        <!-- Informations du pharmacien -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mon espace professionnel"
                android:textColor="#218C58"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPharmacistName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Espace Pharmacien"
                android:textColor="#26352C"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPharmacyName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Ma pharmacie"
                android:textColor="#218C58"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Section statistiques -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="1. Vue d'ensemble"
            android:textColor="#14532D"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Total médicaments -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total des médicaments"
                android:textColor="#718078"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtTotalMedicines"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="0"
                android:textColor="#218C58"
                android:textSize="34sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Médicaments disponibles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Médicaments disponibles"
                android:textColor="#718078"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtAvailableMedicines"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="0"
                android:textColor="#218C58"
                android:textSize="34sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Médicaments indisponibles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Médicaments indisponibles"
                android:textColor="#718078"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtUnavailableMedicines"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="0"
                android:textColor="#D65B55"
                android:textSize="34sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Section gestion -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="2. Gestion de ma pharmacie"
            android:textColor="#14532D"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Gérer les médicaments -->
        <Button
            android:id="@+id/btnManageMedicines"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#218C58"
            android:text="Gérer les médicaments"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Ajouter un médicament -->
        <Button
            android:id="@+id/btnAddMedicine"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#218C58"
            android:text="Ajouter un médicament"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Mon profil -->
        <Button
            android:id="@+id/btnPharmacistProfile"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#E1F2E8"
            android:text="Mon profil"
            android:textAllCaps="false"
            android:textColor="#218C58"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
