<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8F6"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp"
        android:paddingTop="32dp">

        <!-- En-tête PharmaFind -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PharmaFind"
            android:textColor="#218C58"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Titre principal -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="Mon profil"
            android:textColor="#1B5E20"
            android:textSize="25sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Gérez vos informations personnelles et celles de votre pharmacie."
            android:textColor="#718078"
            android:textSize="14sp" />

        <!-- Carte Informations personnelles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Informations personnelles"
                android:textColor="#218C58"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- AJOUT 1 : Nom complet -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Nom complet"
                android:textColor="#26352C"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtProfileName"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="6dp"
                android:background="#F5F8F6"
                android:hint="Nom complet"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="#26352C" />

            <!-- AJOUT 2 : Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Adresse email"
                android:textColor="#26352C"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtProfileEmail"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="6dp"
                android:background="#E1F2E8"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:textColor="#26352C"
                android:textSize="15sp" />

            <!-- AJOUT 3 : Téléphone -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Téléphone"
                android:textColor="#26352C"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtProfilePhone"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="6dp"
                android:background="#F5F8F6"
                android:hint="Numéro de téléphone"
                android:inputType="phone"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="#26352C" />

        </LinearLayout>

        <!-- Carte Informations de la pharmacie -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Informations de la pharmacie"
                android:textColor="#218C58"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- AJOUT 4 : Nom de la pharmacie -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Nom de la pharmacie"
                android:textColor="#26352C"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtProfilePharmacyName"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="6dp"
                android:background="#F5F8F6"
                android:hint="Nom de la pharmacie"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="#26352C" />

            <!-- AJOUT 5 : Adresse de la pharmacie -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Adresse de la pharmacie"
                android:textColor="#26352C"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtProfilePharmacyAddress"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="6dp"
                android:background="#F5F8F6"
                android:gravity="top"
                android:hint="Adresse de la pharmacie"
                android:padding="12dp"
                android:textColor="#26352C" />

        </LinearLayout>

        <!-- AJOUT 6 : Bouton de sauvegarde -->
        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#218C58"
            android:text="Enregistrer les modifications"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

    </LinearLayout>

</ScrollView>
